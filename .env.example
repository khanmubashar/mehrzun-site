# Gmail used to send form emails (netlify/functions/submission-created.ts).
# Local testing: copy to .env.local and fill in, then `npx tsx scripts/test-emails.ts --send`.
# Netlify: add the same names under Project configuration → Environment variables
# (mark GMAIL_APP_PASSWORD as a secret), then redeploy.

GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: where team notifications go (defaults to GMAIL_USER). Comma-separate for several.
TEAM_EMAIL=
